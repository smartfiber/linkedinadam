{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkedinadam",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVOS_AGENT_RUNTIME",
        "class_name": "DevosAgentRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "devos-agent-runtime-v1",
      "new_sqlite_classes": ["DevosAgentRuntime"]
    }
  ],
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "green-wind-7710.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "0a98552ada361a92068eed3a930f704a8a1ef8c6194b3c7573509745003d5e99",
    "BACKOFFICE_OWNER_EMAIL": "adam@net-x.io",
    "BACKOFFICE_ADMIN_EMAILS": "joseph@net-x.io",
    "BACKOFFICE_ENVIRONMENT": "production",
    "GITHUB_APP_ID": "4653503",
    "GITHUB_APP_INSTALLATION_ID": "155240048",
    "GITHUB_REPOSITORY_OWNER": "colossalbreacker",
    "GITHUB_REPOSITORY_NAME": "net-x",
    "GITHUB_SYNC_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "linkedinadam_db",
      "database_name": "linkedinadam-db",
      "database_id": "0ea66e00-0212-4639-8f6d-4852dd4dac73",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "LINKEDIN_IMAGES",
      "bucket_name": "linkedinadam-images",
      "remote": true
    }
  ]
}
